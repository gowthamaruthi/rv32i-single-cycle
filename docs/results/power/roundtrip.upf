# UPF generated by OpenROAD

###############
# Power domains
###############
create_power_domain PD_TOP \
  -elements {.}
create_power_domain PD_CPU \
  -elements {u_core}

#############
# Logic ports
#############
create_logic_port isolate \
  -direction in
create_logic_port power_good \
  -direction in

################
# Power switches
################

############
# Isolations
############
set_isolation CPU_OUTPUTS \
  -domain {PD_CPU} \
  -applies_to outputs \
  -location parent \
  -clamp_value 0 \
  -isolation_signal {isolate} \
  -isolation_sense high

################
# Level shifters
################
